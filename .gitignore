# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Environments
.env
.env.*
.venv/
venv/
env/

# Credentials and local cloud configuration
*credentials*.json
application_default_credentials.json
service-account*.json
*.pem
*.key
.secrets/
secrets/
.gcloud/
.boto

# Large or source-restricted data
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Generated outputs
outputs/*
!outputs/figures/
outputs/figures/*
!outputs/figures/.gitkeep

# Generated reports and paper-facing outputs stay local
reports/
paper/
docs/

# Exploratory analysis scripts stay local
scripts/_archive_experiments/
scripts/analyze_*.py
scripts/run_nlp_taxonomy_experiment.py
scripts/run_placebo_checks.py
scripts/run_rolling_origin_check.py
scripts/run_panel_leave_one_country_out.py
scripts/run_panel_counterfactual_network_swap.py
scripts/run_panel_m1_m2_sanity.py
scripts/build_benchmark_dataset.py
scripts/build_nlp_taxonomy_features.py
scripts/fetch_gkg_nlp_candidate_docs.py
scripts/make_benchmark_figures.py
scripts/run_benchmark_models.py

# Local exploratory notebooks and system files
notebooks/*.ipynb
!notebooks/reproduce_panel_benchmark.ipynb
!notebooks/README.md
*.log
.DS_Store
Thumbs.db

# Keep research proposal drafts local unless intentionally shared
*.docx
*.doc
*proposal*
*draft*
~$*.docx
